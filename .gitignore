Contexto_Proyecto_JSConnect.docx
*.docx

# Estado local del hook de sincronizacion de documentacion (.claude/hooks/)
.claude/hooks/*.local.json

# Perfil del navegador del login asistido (sesion Microsoft/WinForce en disco, PC proxy)
