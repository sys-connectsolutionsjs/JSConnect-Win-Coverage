<!--
  PLANTILLA de referencia del servicio winsw. NO se usa tal cual.

  install_service.bat [8/11] genera el winsw.xml real (gitignored) con rutas
  ABSOLUTAS de la maquina:
    - <executable>  = el interprete que resuelve `python -c "import sys; print(sys.executable)"`
    - <workingdirectory> = raiz del repo (config.py necesita cwd estable; ver _CONFIG_YAML)
    - <logpath>     = <raiz del repo>\logs   (archivos rotados de winsw, NO el Visor de Eventos)

  Los %BASE% de abajo son marcadores; el .bat no hace sustitucion de texto sobre
  este archivo, lo regenera entero.
-->
<service>
  <id>JSWinProxy</id>
  <name>JSConnect Win Proxy</name>
  <description>Proxy local para validación de cobertura y score crediticio (JSConnect Win Coverage). Recibe peticiones de agentes LAN y las reenvía a WinForce/Equifax usando una sola sesión.</description>
  <executable>python</executable>
  <arguments>-m validator_app.proxy.server</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <logmode>rotate</logmode>
  <logpath>%BASE%\logs</logpath>
  <log level="info" />
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONIOENCODING" value="utf-8" />
</service>
