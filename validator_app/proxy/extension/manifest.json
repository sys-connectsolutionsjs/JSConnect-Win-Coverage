{
  "manifest_version": 3,
  "name": "Renovar sesion WinForce (proxy JSConnect)",
  "version": "1.0.0",
  "description": "Renueva la sesion del proxy con un clic, desde tu navegador ya logueado.",
  "permissions": ["cookies", "alarms", "notifications", "storage"],
  "host_permissions": [
    "https://appwinforce.win.pe/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Renovar sesion WinForce",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon.png" }
}
